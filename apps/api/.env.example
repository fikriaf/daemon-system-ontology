# =============================================================================
# apps/api — API Gateway
# Copy ke apps/api/.env lalu isi nilainya
# =============================================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=daemon
DB_PASSWORD=changeme
DB_NAME=daemon

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Ontology schema directory (relatif dari apps/api/)
SCHEMA_DIR=../../schemas

# Internal token — untuk POST /actions/internal/execute
INTERNAL_TOKEN=change-this-internal-token

# Port (default: 3000)
# API_PORT=3000
