# =============================================================================
# apps/agent-service — Agent Service
# Copy ke apps/agent-service/.env lalu isi nilainya
# =============================================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=daemon
DB_PASSWORD=changeme
DB_NAME=daemon

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Ontology schema directory (relatif dari apps/agent-service/)
SCHEMA_DIR=../../schemas

# Tenant default
TENANT_ID=default

# Port (default: 3001)
# AGENT_PORT=3001

# ── Model ─────────────────────────────────────────────────────────────────────
# Format: provider:model-name
# Contoh: openai:gpt-4o | anthropic:claude-sonnet-4-6 | google-genai:gemini-2.0-flash
AGENT_MODEL=openai:gpt-4o

# ── LLM Provider API Key — wajib diset sesuai AGENT_MODEL ────────────────────
OPENAI_API_KEY=

# Alternatif provider:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# ── LangSmith (opsional — untuk tracing) ─────────────────────────────────────
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=daemon-agent-service
# LANGCHAIN_TRACING_V2=true
