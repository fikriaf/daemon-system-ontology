# =============================================================================
# Daemon System Ontology — Environment Variables
# Copy file ini ke .env lalu isi nilainya
# =============================================================================

# ── Database (PostgreSQL + Apache AGE) ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=daemon
DB_PASSWORD=changeme
DB_NAME=daemon

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Ontology Schema ──────────────────────────────────────────────────────────
# Path ke direktori berisi YAML schema (object types, action types, link types)
SCHEMA_DIR=./schemas

# ── API Gateway (apps/api) ───────────────────────────────────────────────────
API_PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# ── Agent Service (apps/agent-service) ───────────────────────────────────────
AGENT_PORT=3001
AGENT_MODEL=openai:gpt-4o
TENANT_ID=default

# ── LLM Provider — pilih salah satu sesuai AGENT_MODEL ───────────────────────
# OpenAI (AGENT_MODEL=openai:gpt-4o / openai:gpt-4o-mini / dll)
OPENAI_API_KEY=

# Anthropic (AGENT_MODEL=anthropic:claude-sonnet-4-6 / dll)
ANTHROPIC_API_KEY=

# Google Gemini (AGENT_MODEL=google-genai:gemini-2.0-flash / dll)
GOOGLE_API_KEY=

# OpenRouter — akses banyak model lewat satu API key
# (AGENT_MODEL=openrouter:anthropic/claude-sonnet-4-6 / dll)
OPENROUTER_API_KEY=

# ── Internal Service Auth ────────────────────────────────────────────────────
# Token untuk POST /actions/internal/execute (hanya antar service)
INTERNAL_TOKEN=change-this-internal-token

# ── LangSmith (opsional — untuk tracing deepagents) ─────────────────────────
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=daemon-system-ontology
# LANGCHAIN_TRACING_V2=true
